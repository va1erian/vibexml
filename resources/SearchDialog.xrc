<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
    
    <!-- Search Dialog -->
    <object class="wxDialog" name="SearchDialog">
        <title>Find</title>
        <size>420,240</size>
        <style>wxDEFAULT_DIALOG_STYLE</style>
        <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            
            <!-- Search label -->
            <object class="sizeritem">
                <flag>wxALL</flag>
                <border>5</border>
                <object class="wxStaticText">
                    <label>Find:</label>
                </object>
            </object>
            
            <!-- Search text control -->
            <object class="sizeritem">
                <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
                <border>5</border>
                <object class="wxTextCtrl" name="SearchTextCtrl">
                    <value></value>
                </object>
            </object>
            
            <!-- Status label for match count and wrap notification -->
            <object class="sizeritem">
                <flag>wxEXPAND|wxALL</flag>
                <border>5</border>
                <object class="wxStaticText" name="SearchStatusLabel">
                    <label></label>
                    <fg>#666666</fg>
                </object>
            </object>
            
            <!-- Case sensitive checkbox -->
            <object class="sizeritem">
                <flag>wxLEFT|wxRIGHT</flag>
                <border>5</border>
                <object class="wxCheckBox" name="CaseSensitiveCheck">
                    <label>Case sensitive</label>
                </object>
            </object>
            
            <!-- Whole words checkbox -->
            <object class="sizeritem">
                <flag>wxALL</flag>
                <border>5</border>
                <object class="wxCheckBox" name="WholeWordCheck">
                    <label>Whole words only</label>
                </object>
            </object>
            
            <!-- Buttons -->
            <object class="sizeritem">
                <flag>wxALIGN_CENTER|wxALL</flag>
                <border>5</border>
                <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    
                    <object class="sizeritem">
                        <flag>wxALL</flag>
                        <border>5</border>
                        <object class="wxButton" name="FindPrevButton">
                            <label>&lt; Previous</label>
                        </object>
                    </object>
                    
                    <object class="sizeritem">
                        <flag>wxALL</flag>
                        <border>5</border>
                        <object class="wxButton" name="wxID_OK">
                            <label>Next &gt;</label>
                            <default>1</default>
                        </object>
                    </object>
                    
                    <object class="sizeritem">
                        <flag>wxALL</flag>
                        <border>5</border>
                        <object class="wxButton" name="wxID_CANCEL">
                            <label>Close</label>
                        </object>
                    </object>
                </object>
            </object>
        </object>
    </object>
    
</resource>

